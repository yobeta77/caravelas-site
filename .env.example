# Subpath where the site is mounted. '' once it lives on the gym's own domain.
BASE_PATH=/testsite/caravelas
NEXT_PUBLIC_SITE_URL=https://nicolino.zip/testsite/caravelas
# false -> noindex,nofollow meta + X-Robots-Tag header
NEXT_PUBLIC_INDEXABLE=false
# fixture | sheets  (sheets lands with Juanpi's adapter)
CONTENT_SOURCE=fixture
REVALIDATE_SECONDS=300
# shared with the Apps Script "Publicar" button
REVALIDATE_SECRET=change-me
# Google Sheet (CONTENT_SOURCE=sheets). Setup: docs/SHEET.md -> Access.
# SHEETS_ID is the part of the sheet URL between /d/ and /edit.
SHEETS_ID=
# Service account (the sheet is private, shared with this email as viewer). From the JSON key file:
# client_email and private_key (with real line breaks or the literal \n). Secret: never commit it.
SHEETS_SA_EMAIL=
SHEETS_SA_PRIVATE_KEY=
# Legacy, only while the sheet is still public by link; used when no SHEETS_SA_* is set.
SHEETS_API_KEY=
